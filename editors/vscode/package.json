{
  "name": "ergo-backlog",
  "displayName": "Ergo Backlog",
  "description": "Browse a dependency-aware Ergo backlog without leaving VS Code.",
  "version": "0.1.1",
  "publisher": "sandover",
  "preview": true,
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandover/ergo.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/sandover/ergo#ergo-backlog-for-vs-code",
  "bugs": {
    "url": "https://github.com/sandover/ergo/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "backlog",
    "task management",
    "dependencies",
    "dependency graph",
    "epics",
    "coding agents",
    "AI agents",
    "agentic development",
    "project planning",
    "repository-local",
    "JSONL",
    "developer tools"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:ergo.listTasks",
    "onCustomEditor:ergo.backlog"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ergo.listTasks",
        "title": "Backlog",
        "category": "Ergo"
      }
    ],
    "customEditors": [
      {
        "viewType": "ergo.backlog",
        "displayName": "Ergo Backlog",
        "selector": [
          {
            "filenamePattern": "**/.ergo/backlog.jsonl"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Ergo",
      "properties": {
        "ergo.executablePath": {
          "type": "string",
          "default": "ergo",
          "scope": "machine-overridable",
          "description": "Path to the Ergo CLI executable. The default resolves ergo from the VS Code extension host's PATH."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -p tsconfig.json",
    "build": "npm run clean && npm run compile",
    "test": "npm run build && node scripts/test.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --out ergo-backlog-0.1.1.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
